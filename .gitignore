/node_modules
/src-tauri/target
*.log

# Модели распознавания (~225 МБ) — не хранятся в git.
# Ставятся одной командой: pwsh scripts/fetch-deps.ps1
/src-tauri/resources/model/
# Создаются debug-запусками (config.rs: dev читает и пишет конфиги в resources/); в установщик не идут.
/src-tauri/resources/usage.json
/src-tauri/resources/grammar.json

# Синтетический корпус (scripts/gen-corpus.ps1); manifest.json хранится в git.
/testdata/corpus/
/testdata/live/*.wav

# Рабочие файлы impeccable и чекпоинты сессий агентов (локальные)
/.impeccable/
/.agents/

# Промежуточные рендеры рамки (пересобираются из design/reever-frame.blend)
/design/renders/
/design/*.blend1
# Синтез lang_eval (голоса piper), кэш.
/testdata/lang-corpus/
/testdata/wake-lang-corpus/
# Записи голоса пользователя для детектора «ривер» — личные, не в git.
/testdata/wake/

# Тестовый exe без установки (tools/test_build.sh)
/test-build/
