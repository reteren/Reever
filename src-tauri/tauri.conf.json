{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reever",
  "version": "0.1.0",
  "identifier": "com.troid.reever",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Reever",
        "width": 900,
        "height": 640,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "windowEffects": { "effects": ["acrylic"], "radius": 10 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AstroDryxx Studio",
    "copyright": "© AstroDryxx Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sounds": "resources/sounds",
      "resources/model/vosk-model-small-ru-0.22": "resources/model/vosk-model-small-ru-0.22",
      "resources/model/vosk-model-small-en-us-0.15": "resources/model/vosk-model-small-en-us-0.15",
      "resources/aliases.json": "resources/aliases.json",
      "resources/settings.json": "resources/settings.json",
      "resources/actions.json": "resources/actions.json",
      "resources/wallpaper.png": "resources/wallpaper.png",
      "vendor/vosk/libvosk.dll": "libvosk.dll",
      "vendor/vosk/libstdc++-6.dll": "libstdc++-6.dll",
      "vendor/vosk/libgcc_s_seh-1.dll": "libgcc_s_seh-1.dll",
      "vendor/vosk/libwinpthread-1.dll": "libwinpthread-1.dll"
    }
  }
}
