{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reever",
  "version": "0.3.9",
  "identifier": "com.troid.reever",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Reever",
        "width": 1280,
        "height": 880,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "maximizable": false,
        "center": true
      },
      {
        "label": "picker",
        "create": false,
        "title": "Reever",
        "url": "picker.html",
        "width": 620,
        "height": 520,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "AstroDryxx Studio",
    "copyright": "© AstroDryxx Studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sounds": "resources/sounds",
      "resources/model/sherpa-onnx-nemo-transducer-giga-am-v3-russian-2025-12-16": "resources/model/sherpa-onnx-nemo-transducer-giga-am-v3-russian-2025-12-16",
      "resources/model/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8": "resources/model/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8",
      "resources/model/silero_vad.onnx": "resources/model/silero_vad.onnx",
      "resources/aliases.json": "resources/aliases.json",
      "resources/anglicisms.tsv": "resources/anglicisms.tsv",
      "resources/settings.json": "resources/settings.json",
      "resources/actions.json": "resources/actions.json",
      "resources/wallpaper.png": "resources/wallpaper.png",
      "resources/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx": "resources/model/sherpa-onnx-whisper-base/base-encoder.int8.onnx",
      "resources/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx": "resources/model/sherpa-onnx-whisper-base/base-decoder.int8.onnx",
      "resources/model/sherpa-onnx-whisper-base/base-tokens.txt": "resources/model/sherpa-onnx-whisper-base/base-tokens.txt",
      "resources/model/sherpa-onnx-streaming-zipformer-small-ru-vosk-int8-2025-08-16/encoder.int8.onnx": "resources/model/sherpa-onnx-streaming-zipformer-small-ru-vosk-int8-2025-08-16/encoder.int8.onnx",
      "resources/model/sherpa-onnx-streaming-zipformer-small-ru-vosk-int8-2025-08-16/decoder.onnx": "resources/model/sherpa-onnx-streaming-zipformer-small-ru-vosk-int8-2025-08-16/decoder.onnx",
      "resources/model/sherpa-onnx-streaming-zipformer-small-ru-vosk-int8-2025-08-16/joiner.int8.onnx": "resources/model/sherpa-onnx-streaming-zipformer-small-ru-vosk-int8-2025-08-16/joiner.int8.onnx",
