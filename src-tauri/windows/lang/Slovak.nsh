LangString addOrReinstall ${LANG_SLOVAK} "Pridať/preinštalovať súčasti"
LangString alreadyInstalled ${LANG_SLOVAK} "Už nainštalované"
LangString alreadyInstalledLong ${LANG_SLOVAK} "${PRODUCTNAME} ${VERSION} je už nainštalovaný. Vyberte operáciu a pokračujte kliknutím na Ďalej."
LangString appRunning ${LANG_SLOVAK} "${PRODUCTNAME} je spustený! Najprv ho zatvorte a skúste to znova."
LangString appRunningOkKill ${LANG_SLOVAK} "${PRODUCTNAME} je spustený!$\nKliknutím na OK ho ukončíte"
LangString chooseMaintenanceOption ${LANG_SLOVAK} "Vyberte operáciu údržby."
LangString choowHowToInstall ${LANG_SLOVAK} "Vyberte, ako chcete ${PRODUCTNAME} nainštalovať."
LangString createDesktop ${LANG_SLOVAK} "Vytvoriť odkaz na ploche"
LangString dontUninstall ${LANG_SLOVAK} "Neodinštalovať"
LangString dontUninstallDowngrade ${LANG_SLOVAK} "Neodinštalovať (inštalácia staršej verzie bez odinštalovania je v tomto inštalátore zakázaná)"
LangString failedToKillApp ${LANG_SLOVAK} "${PRODUCTNAME} sa nepodarilo ukončiť. Najprv ho zatvorte a skúste to znova"
LangString installingWebview2 ${LANG_SLOVAK} "Inštalácia WebView2..."
LangString newerVersionInstalled ${LANG_SLOVAK} "Novšia verzia ${PRODUCTNAME} je už nainštalovaná! Inštalácia staršej verzie sa neodporúča. Ak ju naozaj chcete nainštalovať, najprv odinštalujte aktuálnu verziu. Vyberte operáciu a pokračujte kliknutím na Ďalej."
LangString older ${LANG_SLOVAK} "staršia"
LangString olderOrUnknownVersionInstalled ${LANG_SLOVAK} "V systéme je nainštalovaná $R4 verzia ${PRODUCTNAME}. Pred inštaláciou sa odporúča aktuálnu verziu odinštalovať. Vyberte operáciu a pokračujte kliknutím na Ďalej."
LangString silentDowngrades ${LANG_SLOVAK} "Inštalácia starších verzií je v tomto inštalátore zakázaná, tichú inštaláciu nemožno dokončiť; použite inštalátor s grafickým rozhraním.$\n"
LangString unableToUninstall ${LANG_SLOVAK} "Odinštalovanie zlyhalo!"
LangString uninstallApp ${LANG_SLOVAK} "Odinštalovať ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_SLOVAK} "Pred inštaláciou odinštalovať"
LangString unknown ${LANG_SLOVAK} "neznáma"
LangString webview2AbortError ${LANG_SLOVAK} "WebView2 sa nepodarilo nainštalovať! Aplikácia bez neho nefunguje. Skúste inštalátor spustiť znova."
