LangString webview2DownloadSuccess ${LANG_SLOVAK} "Inštalátor WebView2 bol stiahnutý"
LangString webview2Downloading ${LANG_SLOVAK} "Sťahovanie inštalátora WebView2..."
LangString webview2InstallError ${LANG_SLOVAK} "Chyba: inštalácia WebView2 skončila kódom $1"
LangString webview2InstallSuccess ${LANG_SLOVAK} "WebView2 bol nainštalovaný"
