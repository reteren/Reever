!insertmacro REEVER_LANG GREEK reeverEuAccurate "Ακριβές: λήψη 573 MB, καλύτερη αναγνώριση"
!insertmacro REEVER_LANG GREEK reeverEuLight "Ελαφρύ: λήψη 350 MB, λιγότερη μνήμη"
